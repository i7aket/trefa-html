{
  "trailingSlash": "auto",
  "routes": [
    { "route": "/index", "redirect": "/", "statusCode": 301 },
    { "route": "/index.html", "redirect": "/", "statusCode": 301 },
    { "route": "/images/*", "headers": { "cache-control": "public, max-age=604800" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  }
}
